  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "build:mobile": "cross-env VUE_APP_MODE=mobile CAP_ENV=production vue-cli-service build && node -e \"require('fs').rmSync('dist/app',{recursive:true,force:true})\" && cross-env CAP_ENV=production npx cap sync android",
