<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA del server_client_id para el login nativo de Google en Android.

  Tras ejecutar `npx cap add android`, copia este fichero a:
      frontend/android/app/src/main/res/values/secrets.xml
  y pon ahí tu Google OAuth client ID de tipo **WEB** (NO el de Android).
  En statCoin el Web client ID es el mismo de VUE_APP_GOOGLE_CLIENT_ID / GOOGLE_CLIENT_ID
  (600759105035-…apps.googleusercontent.com).

  El plugin @codetrix-studio/capacitor-google-auth lee automáticamente el recurso
  string `server_client_id`. El cliente OAuth de Android NO se referencia en ningún
  sitio: solo autoriza por paquete (com.statcoin.app) + huella SHA-1.

  secrets.xml está gitignoreado; este .example sí se versiona.
-->
<resources>
    <string name="server_client_id">600759105035-de8vpri6f2f5d8erkgfs9h2nhljs73iu.apps.googleusercontent.com</string>
</resources>
