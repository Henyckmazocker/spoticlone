# Copy to .env (dev: `docker compose up`) or to .env.prod (prod:
# `docker compose -p spoticlone_prod --env-file .env.prod -f docker-compose.prod.yml up -d --build`).
# Dev and prod use SEPARATE files with DIFFERENT secrets. Replace every CHANGE_ME with its own
# value generated with `openssl rand -base64 48` (for DB passwords prefer alphanumeric only:
# compose interpolates `$` in env files). Never commit real secrets: this repo is public.
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Absolute path on the HOST to your music library. Mounted read-only into the backend.
MUSIC_LIBRARY_PATH=/media/david/Elements2/01Media/music

# Google OAuth client id (web). Leave empty to disable Google login in dev.
GOOGLE_CLIENT_ID=
# Secret used to sign JWTs AND (via a derived key) the short-lived stream/cover URLs.
# >= 32 chars; in production the backend refuses to run with a short value or CHANGE_ME.
JWT_SECRET=CHANGE_ME

# Max registered users. New Google accounts are rejected (403) once reached; existing users
# keep logging in. 0 = no limit.
MAX_USERS=10

# Admin emails (comma-separated, case-insensitive). Only they can scan, delete, download from
# Soulseek and issue external URLs. Empty = nobody is admin.
ADMIN_EMAILS=CHANGE_ME@example.com

# Lifetime (seconds) of signed stream/cover URLs.
STREAM_URL_TTL=3600

# External (third-party) stream URLs, issued with the `issue_external_urls` action.
# PUBLIC_BASE_URL: public origin prepended to those URLs, no trailing slash. PROD-ONLY override:
# dev reads .env and prod reads .env.prod, so only set it in .env.prod. Dev hardcodes
# http://localhost:8892 in docker-compose.yml; prod defaults to https://spoticlone.dcahomelab.com.
# PUBLIC_BASE_URL=https://spoticlone.dcahomelab.com
# Max lifetime (seconds) of an external URL; requested TTLs above it are clamped. 86400 = 24 h.
EXTERNAL_URL_MAX_TTL=86400

# Optional metadata enrichment. Leave empty to run scanner from embedded tags only.
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Soulseek (slskd) integration. SLSKD_API_KEY from slskd.yml (web.authentication.api_keys).
# DOWNLOADS_PATH = slskd's download dir on the HOST (mounted into the backend at /downloads).
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=
DOWNLOADS_PATH=/media/david/Elements2/downloads
