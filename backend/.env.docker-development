APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid

# Database (must match docker-compose mysql service)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=spoticlone_db
DB_USERNAME=spoticlone_user
DB_PASSWORD=spoticlone_pass

LOG_PATH=/var/www/html/storage/logs

# Auth — set GOOGLE_CLIENT_ID to enable Google login. JWT_SECRET signs mobile tokens
# AND the short-lived stream/cover URLs, so it must be set.
JWT_SECRET=dev-secret-change-me-at-least-32-characters-long
GOOGLE_CLIENT_ID=

# Login whitelist (comma-separated). Empty = anyone with a valid Google account can log in.
ALLOWED_EMAILS=

# Root of the music library INSIDE the container (mounted read-only by docker-compose).
MUSIC_ROOT=/music
# Where extracted/embedded cover art is cached (inside the container).
COVERS_PATH=/var/www/html/storage/covers
# Lifetime (seconds) of signed stream/cover URLs.
STREAM_URL_TTL=3600

# Optional metadata enrichment (leave empty to disable; scanner still works from tags).
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Soulseek (slskd) integration. SLSKD_API_KEY comes from slskd.yml (web.authentication.api_keys).
# SLSKD_URL resolves over the shared `mediaserver` Docker network. DOWNLOADS_ROOT is slskd's
# download dir as mounted inside THIS container.
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=
DOWNLOADS_ROOT=/downloads/slskd
