{
  "name": "spoticlone/backend",
  "description": "Backend PHP para spoticlone: streaming de una biblioteca de música local (tipo Spotify)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "firebase/php-jwt": "^6.0",
    "monolog/monolog": "^3.0",
    "php-di/php-di": "^7.0",
    "guzzlehttp/guzzle": "^7.0",
    "google/apiclient": "^2.15",
    "james-heinrich/getid3": "^1.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit"
  },
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "process-timeout": 600,
    "preferred-install": "dist",
    "audit": {
      "ignore": ["PKSA-y2cr-5h3j-g3ys"]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  }
}
