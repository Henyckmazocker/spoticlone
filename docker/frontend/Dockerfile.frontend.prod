# statCoin Vue frontend (producción) — build estático servido por nginx.
# Stage 1: build de la app Vue
FROM node:22-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./

# --legacy-peer-deps: capacitor-google-auth declara un peer @capacitor/core antiguo.
RUN npm install --legacy-peer-deps

COPY frontend/src ./src
COPY frontend/public ./public
COPY frontend/babel.config.js .
COPY frontend/jsconfig.json .
COPY frontend/vue.config.js .

# Inyectado en build desde docker-compose.prod.yml
ARG VUE_APP_API_URL
ARG VUE_APP_GOOGLE_CLIENT_ID
ENV VUE_APP_API_URL=${VUE_APP_API_URL}
ENV VUE_APP_GOOGLE_CLIENT_ID=${VUE_APP_GOOGLE_CLIENT_ID}

# Genera /app/dist con assets hasheados (js/app.[contenthash].js)
RUN npm run build

# Stage 2: servir con nginx
FROM nginx:1.30.6-alpine

RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf
# Snippet fuera de conf.d/ (conf.d/*.conf se carga solo en http); se usa vía include.
COPY docker/nginx/security_headers.conf /etc/nginx/snippets/security_headers.conf

RUN chown -R nginx:nginx /usr/share/nginx/html && chmod -R 755 /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
